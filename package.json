{
  "name": "nativescript-apple-runtime-monorepo",
  "private": true,
  "description": "Monorepo for NativeScript Apple runtimes and related packages",
  "version": "0.0.0",
  "keywords": [
    "NativeScript",
    "iOS",
    "runtime"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/NativeScript/runtimes"
  },
  "author": {
    "name": "NativeScript Team",
    "email": "oss@nativescript.org"
  },
  "workspaces": [
    "packages/*",
    "platforms/apple/examples",
    "scripts"
  ],
  "scripts": {
    "build-ios": "./scripts/build_all_ios.sh",
    "build-macos": "./scripts/build_all_macos.sh",
    "build-vision": "./scripts/build_all_vision.sh",
    "build-visionos": "./scripts/build_all_vision.sh",
    "build-node-api": "./scripts/build_all_react_native.sh",
    "build-rn-turbomodule": "./scripts/build_react_native_turbomodule.sh",
    "check:ffi-boundaries": "./scripts/check_ffi_boundaries.sh",
    "check:jsi-neutral": "./scripts/check_jsi_layer_neutral.sh",
    "test-rn-turbomodule": "./scripts/test_react_native_turbomodule.sh",
    "test-rn-ffi": "./scripts/test_react_native_ffi_compat.sh",
    "demo-rn-turbomodule": "./scripts/create_react_native_demo.sh",
    "pack:ios": "./scripts/build_npm_ios.sh",
    "pack:macos": "./scripts/build_npm_macos.sh",
    "pack:visionos": "./scripts/build_npm_vision.sh",
    "setup-ci": "./scripts/build_metadata_generator.sh",
    "update-version": "./scripts/update_version.sh ios",
    "update-version:ios": "./scripts/update_version.sh ios",
    "update-version:macos": "./scripts/update_version.sh macos",
    "update-version:visionos": "./scripts/update_version.sh visionos",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "version": "npm run changelog && git add CHANGELOG.md",
    "build-libffi": "node scripts/build_libffi.js",
    "build-metagen": "./scripts/build_metadata_generator.sh",
    "metagen": "node scripts/metagen.js",
    "build": "./scripts/build_nativescript.sh",
    "build:ios": "./scripts/build_nativescript.sh --iphone --no-simulator --no-macos",
    "build:ios-sim": "./scripts/build_nativescript.sh --no-iphone --simulator --no-macos",
    "build:macos": "./scripts/build_nativescript.sh --macos --no-iphone --no-simulator",
    "build:macos-cli": "./scripts/build_nativescript.sh --no-iphone --no-simulator --no-macos --macos-cli --v8",
    "build:macos-napi": "./scripts/build_nativescript.sh --no-iphone --no-simulator --macos-napi",
    "nsr": "./dist/nsr",
    "test:macos": "node ./scripts/run-tests-macos.js",
    "test:ios": "node ./scripts/run-tests-ios.js",
    "benchmark:objc-dispatch": "node ./platforms/apple/benchmarks/objc-dispatch/run.js",
    "benchmark:objc-dispatch:cli:compare": "node ./platforms/apple/benchmarks/objc-dispatch/compare-cli.js",
    "test:react-native": "node ./packages/react-native/test/run-all.js"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "conventional-changelog-cli": "^2.1.1",
    "dayjs": "^1.11.7",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "semver": "^7.5.0"
  },
  "lint-staged": {
    "{NativeScript,metadata-generator/src,platforms/apple/test/runtime/fixtures}/**/*.{h,hpp,c,cpp,mm,m}": [
      "clang-format -i"
    ]
  }
}
