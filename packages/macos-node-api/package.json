{
  "name": "@nativescript/macos-node-api",
  "version": "0.4.4",
  "description": "An embeddable, engine-agnostic NativeScript runtime for macOS based on Node-API",
  "repository": {
    "type": "git",
    "url": "https://github.com/NativeScript/napi-ios.git",
    "directory": "packages/macos-node-api"
  },
  "main": "index.js",
  "typings": "index.d.ts",
  "type": "module",
  "files": [
    "./*.d.ts",
    "build/RelWithDebInfo/NativeScript.apple.node",
    "index.cjs",
    "index.d.ts",
    "index.mjs",
    "types"
  ],
  "scripts": {
    "test": "node ../../platforms/apple/examples/foundation.js",
    "build": "cd ../.. && ./scripts/build_all_react_native.sh"
  },
  "keywords": [
    "AppKit",
    "macOS",
    "NativeScript"
  ],
  "contributors": [
    {
      "name": "DjDeveloperr"
    },
    {
      "name": "Jamie Birch"
    },
    {
      "name": "Nathan Walker"
    },
    {
      "name": "Eduardo Speroni"
    },
    {
      "name": "NativeScript",
      "email": "oss@nativescript.org"
    }
  ],
  "license": "MIT",
  "dependencies": {
    "@nativescript/objc-node-api": "^1.0.0-alpha.7"
  },
  "devDependencies": {
    "rimraf": "^6.0.0"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  }
}
